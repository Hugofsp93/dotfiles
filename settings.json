{
    "workbench.iconTheme": "material-icon-theme",
    "workbench.colorTheme": "One Dark Pro Night Flat",
    "files.associations": {
        "*.svelte": "svelte"
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "workbench.layoutControl.enabled": false,
    "editor.renderWhitespace": "none",
    "window.autoDetectColorScheme": false,
    "editor.fontSize": 18,
    "editor.fontLigatures": true,
    "editor.colorDecorators": true,
    "editor.codeLens": false,
    "editor.lightbulb.enabled": "off",
    "editor.hover.enabled": "off",
    "editor.tabSize": 2,
    "editor.showFoldingControls": "never",
    "terminal.integrated.fontLigatures.enabled": true,
    "workbench.reduceMotion": "off",
    "workbench.activityBar.location": "top",
    "workbench.navigationControl.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "workbench.tips.enabled": false,
    "workbench.tree.renderIndentGuides": "none",
    "workbench.tree.indent": 16,
    "workbench.experimental.fontFamily": "JetBrainsMono Nerd Font Mono",
    "window.commandCenter": false,
    "editor.minimap.enabled": false,
    "editor.fontFamily": "JetBrainsMono Nerd Font Mono",
    "workbench.startupEditor": "none",
    "workbench.sideBar.experimental.fontSize": 18,
    "workbench.statusBar.experimental.fontSize": 16,
    "workbench.tabs.experimental.fontSize": 16,
    "explorer.compactFolders": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "extensions.ignoreRecommendations": true,
    "window.title": " ",
    "workbench.sideBar.location": "right",
    "workbench.productIconTheme": "icons-carbon",
    "workbench.bottomPane.experimental.fontSize": 14,
    "workbench.experimental.fontSize": 16,
    "chat.editor.fontSize": 16,
    "terminal.integrated.fontSize": 16,
    "scm.inputFontSize": 16,
    "workbench.editor.titleScrollbarVisibility": "hidden",
    "editor.scrollbar.verticalScrollbarSize": 10,
    "editor.scrollPredominantAxis": false,
    "editor.scrollbar.vertical": "hidden",
    "editor.scrollbar.horizontal": "hidden",
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.scrollbar.horizontalScrollbarSize": 10,
    "svelte.enable-ts-plugin": true,
    "material-icon-theme.hidesExplorerArrows": true,
    "workbench.statusBar.visible": false,
    "breadcrumbs.enabled": false,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true
}
