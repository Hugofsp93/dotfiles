theme = Miasma
# Gruvbox Material Dark
# Twilight
# theme = Violite

macos-icon = holographic

mouse-hide-while-typing = true

keybind = super+bracket_left=goto_split:previous
keybind = super+bracket_right=goto_split:next

keybind = super+ctrl+arrow_left=goto_split:previous
keybind = super+ctrl+arrow_right=goto_split:next

keybind = super+d=new_split:auto
keybind = cmd+up=text:\x1b[1;9A

window-inherit-working-directory = false
working-directory = /Users/hugofelipe/

font-size = 20

unfocused-split-opacity = 1
fullscreen = true
window-padding-y = 32,32
window-padding-x = 8,32

shell-integration-features = no-cursor
cursor-style = underline
cursor-color = #39FF14
adjust-cursor-thickness = 5

